rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActiveTeamMember(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.status == "active";
    }

    function validUserKeys() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "setup",
        "identity",
        "updatedAt"
      ]);
    }

    function validUserIdentity(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && (
          !("email" in request.auth.token)
          || request.resource.data.email == request.auth.token.email
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function validSetup() {
      return !("setup" in request.resource.data)
        || (
          request.resource.data.setup is map
          && request.resource.data.setup.size() <= 24
        );
    }

    function validIdentityCache() {
      return !("identity" in request.resource.data)
        || (
          request.resource.data.identity is map
          && request.resource.data.identity.keys().hasOnly([
            "roles",
            "teamMemberships",
            "updatedAt"
          ])
          && (!("roles" in request.resource.data.identity)
            || (request.resource.data.identity.roles is list
              && request.resource.data.identity.roles.size() <= 2))
          && (!("teamMemberships" in request.resource.data.identity)
            || (request.resource.data.identity.teamMemberships is list
              && request.resource.data.identity.teamMemberships.size() <= 20))
        );
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && validUserKeys()
        && validUserIdentity(uid)
        && validSetup()
        && validIdentityCache();

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "email",
          "setup",
          "identity",
          "updatedAt"
        ])
        && validUserIdentity(uid)
        && validSetup()
        && validIdentityCache();

      allow delete: if false;

      // Metrics are written and shared only by authenticated server endpoints.
      match /teamMetrics/{date} {
        allow read, write: if false;
      }

      // AI metering and provider usage are server-authoritative.
      match /aiUsage/{date} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /teams/{teamId} {
      // Active members may discover their own team name/status. Roster,
      // management, and athlete profile/metric reads remain server-only.
      allow get: if isActiveTeamMember(teamId);
      allow list, create, update, delete: if false;

      match /members/{memberId} {
        allow get: if signedIn()
          && request.auth.uid == memberId
          && resource.data.uid == request.auth.uid;
        allow list, create, update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Supports the existing collectionGroup("members") self-membership query.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Global controls, request idempotency, and aggregate usage are private.
    match /system/{document=**} {
      allow read, write: if false;
    }

    match /aiRequests/{document=**} {
      allow read, write: if false;
    }

    match /aiSystemUsage/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
